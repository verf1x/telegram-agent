# Copy to .env and fill in the token and positive numeric Telegram user IDs.
# The owner always has access; ALLOWED_USER_IDS is a comma-separated list.
TELEGRAM_BOT_TOKEN=
OWNER_TELEGRAM_ID=
ALLOWED_USER_IDS=

# These paths are private to the trusted bot process, never mounted for agent code.
DATABASE_PATH=./runtime/bot.sqlite
RUNTIME_DIR=./runtime

MAX_CONCURRENT_REQUESTS=4
REQUEST_TIMEOUT_MS=600000
POLL_TIMEOUT_SECONDS=30
CONFIG_RELOAD_INTERVAL_MS=500

# All users start with gpt-6.1-sol / medium. Only the owner can use /model.
